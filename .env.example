# ──────────────────────────────────────
# DocAssistant AI - Environment Variables
# ──────────────────────────────────────

# Google Gemini API Key (required)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL (defaults work with docker-compose)
POSTGRES_DB=docassistant
POSTGRES_USER=docassistant
POSTGRES_PASSWORD=docassistant_secret

# Redis (defaults work with docker-compose)
REDIS_HOST=localhost
REDIS_PORT=6379
